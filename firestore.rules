rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    function isValidDocId(id) {
      return id is string && id.size() > 0 && id.size() <= 256;
    }

    // =========================================================================
    // 1. SITE PHOTOS (Fotos do Site, Técnicos, Banners, Carrossel)
    // =========================================================================
    match /site_photos/{photoId} {
      allow read, write: if isValidDocId(photoId);
    }

    // =========================================================================
    // 2. GALLERY (Galeria de Fotos Geral da ACEDEP)
    // =========================================================================
    match /gallery/{photoId} {
      allow read, write: if isValidDocId(photoId);
    }

    // =========================================================================
    // 3. ANNUAL CALENDAR EVENTS (Competições, Campeonatos e Eventos Anuais)
    // =========================================================================
    match /annual_events/{eventId} {
      allow read, write: if isValidDocId(eventId);
    }

    // =========================================================================
    // 4. COMMUNITY CHEERS (Mural de Incentivo & Recados da Família)
    // =========================================================================
    match /community_cheers/{cheerId} {
      allow read, write: if isValidDocId(cheerId);
    }

    // =========================================================================
    // 5. NEWS & POSTS (Notícias, Comunicados e Resultados)
    // =========================================================================
    match /news_posts/{postId} {
      allow read, write: if isValidDocId(postId);
    }

    // =========================================================================
    // 6. ATHLETES & PORTAL (Cadastro Geral de Atletas, Métricas e Documentos)
    // =========================================================================
    match /athletes/{athleteId} {
      allow read, write: if isValidDocId(athleteId);
    }

    // =========================================================================
    // 7. ATTENDANCE SESSIONS (Chamadas, Frequência e Presença em Treinos)
    // =========================================================================
    match /attendance_sessions/{sessionId} {
      allow read, write: if isValidDocId(sessionId);
    }

    // =========================================================================
    // 8. EMAIL NOTIFICATIONS (Logs de Comunicados e E-mails Enviados aos Pais)
    // =========================================================================
    match /email_notifications/{notificationId} {
      allow read, write: if isValidDocId(notificationId);
    }

    // =========================================================================
    // 9. ENROLLMENT REQUESTS (Pré-inscrições de Novos Atletas)
    // =========================================================================
    match /enrollment_requests/{requestId} {
      allow read, write: if isValidDocId(requestId);
    }

    // =========================================================================
    // 10. ADMIN USERS & ACCOUNTS (Administradores e Professores)
    // =========================================================================
    match /admin_users/{userId} {
      allow read, write: if isValidDocId(userId);
    }

    // =========================================================================
    // 11. GUARDIAN ACCOUNTS & MESSAGES (Contas e Mensagens de Responsáveis)
    // =========================================================================
    match /guardian_accounts/{accountId} {
      allow read, write: if isValidDocId(accountId);
    }

    match /athlete_messages/{messageId} {
      allow read, write: if isValidDocId(messageId);
    }

    // =========================================================================
    // 12. SYSTEM SETTINGS & INITIALIZATION FLAGS
    // =========================================================================
    match /settings/{settingId} {
      allow read, write: if isValidDocId(settingId);
    }
  }
}
